rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permite que apenas o próprio usuário autenticado leia e escreva seus próprios dados
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Permite ler/escrever em subcoleções (routines, workout_sessions, settings) recursivamente
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Regras para o acervo de lições padrões
    match /templates/{templateId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Regras de controle de administradores
    match /admins/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
